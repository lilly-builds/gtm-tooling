# Copy to .env.local and fill locally. Never commit .env.local.
WRITE_KEY=replace-with-rudderstack-source-write-key
DATA_PLANE_URL=https://replace-with-rudderstack-data-plane-url
EAS_BUILD_USER_ID=user_test_123
EAS_BUILD_USER_EMAIL=dev@example.test
EAS_BUILD_ORG_ID=org_test_123
EAS_BUILD_PROJECT_ID=project_test_123
EAS_BUILD_PLATFORM=ios
EAS_BUILD_IS_FIRST_SUCCESS=true
CLICKHOUSE_HOST=replace-with-clickhouse-service-hostname
CLICKHOUSE_RUDDERSTACK_LOADER_PASSWORD=replace-with-database-loader-password
